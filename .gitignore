# ==========================================================
# QUICKVAULT GIT IGNORE
# File: .gitignore
# ==========================================================


# ===== PYTHON CACHE START =====

__pycache__/
*.py[cod]
*$py.class

# ===== PYTHON CACHE END =====


# ===== VIRTUAL ENVIRONMENT START =====

venv/
.venv/
env/

# ===== VIRTUAL ENVIRONMENT END =====


# ===== LOCAL DATABASE START =====

instance/*.db
*.sqlite
*.sqlite3

# ===== LOCAL DATABASE END =====


# ===== USER UPLOADS START =====

uploads/*
!uploads/.gitkeep

# ===== USER UPLOADS END =====


# ===== ENVIRONMENT SECRETS START =====

.env
.env.*
*.key

# ===== ENVIRONMENT SECRETS END =====


# ===== EDITOR AND SYSTEM FILES START =====

.vscode/
.DS_Store
Thumbs.db

# ===== EDITOR AND SYSTEM FILES END =====
# ===== LOG FILES START =====

*.log

# ===== LOG FILES END =====


# ===== TEST AND BUILD FILES START =====

.pytest_cache/
dist/
build/

# ===== TEST AND BUILD FILES END =====